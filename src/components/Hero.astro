---
import { Image } from 'astro:assets';
import { BadgeCheck, Briefcase, GraduationCap, Timer, Clock, Users, Play, Gift, User, Mail, ArrowRight, CheckCircle, Lock } from '@lucide/astro';
import heroImage from '../images/wedding-hero.webp';
---

<section class="relative min-h-screen flex items-start md:items-center justify-center pt-18 md:pt-28 pb-12 md:pb-16 overflow-hidden">
  <!-- Dynamic Background with Overlay -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={heroImage} 
      alt="Boda de lujo decorada con elegancia" 
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      widths={[640, 1024, 1440, 2070]}
      sizes="100vw"
      format="webp"
      quality={75}
    />
    <div class="absolute inset-0 bg-navy/80 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-transparent"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10 max-w-4xl text-center">
    <!-- Copy -->
    <div class="text-white space-y-5 md:space-y-6 mt-1 md:mt-0">
      <div class="flex flex-wrap gap-2 justify-center">
        <div class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur px-3 md:px-4 py-1 rounded-full border border-white/20 text-xs md:text-sm font-medium text-gold-light">
          <span class="animate-pulse text-[10px] md:text-xs">●</span> Cupos Limitados
        </div>
      </div>
      
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold font-serif leading-tight max-w-3xl mx-auto">
        Diplomado Profesional en Organización de Eventos & Wedding Planning
      </h1>
      
      <p class="text-lg md:text-2xl font-medium text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-slate-400 max-w-2xl mx-auto drop-shadow-sm pb-1">
        Convierte tu Pasión en un <span class="text-gold italic font-bold">Negocio Rentable</span> con Beca de Idiomas Incluida. Domina el arte de crear experiencias inolvidables.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-col sm:flex-row gap-4 pt-4 justify-center">
        <div class="flex items-center gap-3 bg-navy-light/50 p-3 rounded-lg border border-white/10 text-left">
          <BadgeCheck class="text-blue-400 w-6 h-6 shrink-0" />
          <div>
            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Beneficio</p>
            <p class="font-semibold text-[11px] md:text-sm">Beca de Idiomas 🌐</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-navy-light/50 p-3 rounded-lg border border-white/10 text-left">
          <Briefcase class="text-emerald-400 w-6 h-6 shrink-0" />
          <div>
            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Bolsa de</p>
            <p class="font-semibold text-[11px] md:text-sm">Empleo Garantizada</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-navy-light/50 p-3 rounded-lg border border-white/10 text-left">
          <GraduationCap class="text-gold w-6 h-6 shrink-0" />
          <div>
            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Clases</p>
            <p class="font-semibold text-[11px] md:text-sm">100% Online + Tutores</p>
          </div>
        </div>
      </div>
      
      <!-- Duration, Flexibility & Providers Info -->
      <div class="flex flex-wrap gap-2 md:gap-3 pt-2 justify-center">
        <div class="inline-flex items-center gap-1.5 md:gap-2 bg-emerald-500/20 backdrop-blur-sm px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-emerald-400/30 flex-shrink-0">
          <Timer class="w-3.5 h-3.5 md:w-4 md:h-4 text-emerald-400" />
          <span class="text-[10px] md:text-sm font-semibold text-white">Duración: <span class="text-emerald-300">3 Meses</span></span>
        </div>
        <div class="inline-flex items-center gap-1.5 md:gap-2 bg-blue-500/20 backdrop-blur-sm px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-blue-400/30 flex-shrink-0">
          <Clock class="w-3.5 h-3.5 md:w-4 md:h-4 text-blue-400" />
          <span class="text-[10px] md:text-sm font-semibold text-white">Horarios <span class="text-blue-300">Flexibles</span></span>
        </div>
        <div class="inline-flex items-center gap-1.5 md:gap-2 bg-amber-500/20 backdrop-blur-sm px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-amber-400/30 flex-shrink-0">
          <Users class="w-3.5 h-3.5 md:w-4 md:h-4 text-amber-400" />
          <span class="text-[10px] md:text-sm font-semibold text-white">Lista de <span class="text-amber-300">Proveedores 📋</span></span>
        </div>
      </div>

      <!-- Separation & Lead Magnet Card (Mobile First & Luxury Design) -->
      <div class="mt-8 sm:mt-10 mb-4 sm:mb-6">
        <div 
          x-data="{
            nombre: '',
            email: '',
            sending: false,
            submitted: false,
            get isEmailValid() {
              return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.email.trim());
            },
            get isFormValid() {
              return this.nombre.trim().length >= 2 && this.isEmailValid;
            },
            async submitLead() {
              if (!this.isFormValid || this.sending) return;
              this.sending = true;

              // Tracking
              try {
                if (window.fbq) {
                  fbq('track', 'Lead', {
                    content_name: 'Checklist Wedding Planner - Hero',
                    content_category: 'Lead Magnet',
                    currency: 'USD',
                    value: 0
                  });
                }
              } catch(e) {}

              try {
                if (window.gtag) {
                  gtag('event', 'generate_lead', {
                    event_category: 'Lead Magnet',
                    event_label: 'Checklist Wedding Planner - Hero'
                  });
                }
              } catch(e) {}

              const payload = JSON.stringify({
                'NOMBRE Y APELLIDOS': this.nombre.trim(),
                'CORREO ELECTRÓNICO': this.email.trim(),
                nombre: this.nombre.trim(),
                email: this.email.trim(),
                hoja: 'wedding',
                documento: 'LEAD_USA_WEDDING',
                origen: 'weddingusa',
                tipo_lead: 'checklist_wedding_planner',
                seccion: 'hero',
                page_url: window.location.href,
                user_agent: navigator.userAgent
              });

              try {
                await Promise.race([
                  fetch('https://script.google.com/macros/s/AKfycbxhu4jwl2ilgEOa28rqF5dbT6rGPqB4Kzebqphz4D311xYn6CFBFAS63B8sPwVijj40/exec', {
                    method: 'POST',
                    mode: 'no-cors',
                    keepalive: true,
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: payload
                  }),
                  new Promise((resolve) => setTimeout(resolve, 1400))
                ]);
              } catch(e) {
                console.warn('[Lead Hero]', e);
              }

              this.sending = false;
              this.submitted = true;
            }
          }"
          class="w-full max-w-xl mx-auto bg-gradient-to-b from-navy-light/95 via-slate-900/95 to-[#080E1E]/95 backdrop-blur-xl border border-gold/35 rounded-2xl sm:rounded-3xl p-5 sm:p-7 shadow-2xl shadow-black/70 text-left relative overflow-hidden"
        >
          <!-- Ambient Gold Glow Inside Card -->
          <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-64 h-24 bg-gold/15 rounded-full blur-2xl pointer-events-none"></div>
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold/20 via-gold to-gold/20"></div>

          <!-- Success State (No redirection, elevated professional tone) -->
          <div 
            x-show="submitted" 
            x-transition.opacity 
            style="display: none;" 
            class="text-center py-6 px-2 sm:px-4 space-y-3"
          >
            <div class="inline-flex items-center justify-center bg-emerald-500/20 text-emerald-400 p-3 rounded-full border border-emerald-400/30 shadow-inner">
              <CheckCircle class="w-9 h-9 text-emerald-400" />
            </div>
            
            <h4 class="text-xl sm:text-2xl font-bold font-serif text-white tracking-tight">
              ¡Checklist enviado con éxito!
            </h4>
            
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed max-w-md mx-auto">
              Hemos despachado la guía oficial a tu correo electrónico. Ya está lista para ser descargada en tu bandeja de entrada.
            </p>

            <div class="p-3 sm:p-3.5 bg-white/5 rounded-xl border border-white/10 text-xs text-slate-300 max-w-md mx-auto">
              <p>
                Continúa explorando la página a continuación para conocer el temario, la certificación internacional y los beneficios del programa.
              </p>
            </div>

            <div class="pt-2">
              <a 
                href="#video-section" 
                class="inline-flex items-center gap-2 text-xs sm:text-sm text-gold-light hover:text-white font-medium underline underline-offset-4 transition-colors"
              >
                <span>Desplazarse al video de presentación</span>
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </div>

          <!-- Form Fields (Mobile First layout with generous touch targets) -->
          <div x-show="!submitted" class="space-y-4">
            
            <!-- Header of the Card -->
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1.5 bg-gold/20 text-gold-light px-3 py-1 rounded-full border border-gold/40 text-[10px] sm:text-xs font-semibold tracking-wider uppercase">
                  <Gift class="w-3.5 h-3.5 text-gold" />
                  <span>Recurso Gratuito</span>
                </span>
                <span class="text-[11px] sm:text-xs text-slate-400 font-medium">Entrega directa en PDF</span>
              </div>

              <h3 class="text-base sm:text-lg md:text-xl font-bold font-serif text-white leading-snug">
                Obtén tu Checklist Profesional para Organizar Bodas
              </h3>
              
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Ingresa tu nombre y correo para recibir la guía práctica con las etapas clave de planificación:
              </p>
            </div>

            <!-- Inputs (Mobile First: stacked cleanly, 48px touch targets) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <!-- Nombre -->
              <div>
                <label for="hero_lead_nombre" class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-1">
                  Nombre Completo
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <User class="w-4 h-4" />
                  </div>
                  <input 
                    type="text" 
                    id="hero_lead_nombre"
                    x-model="nombre"
                    autocomplete="name"
                    placeholder="Ej. Sofía Hernández" 
                    class="w-full bg-slate-950/60 border border-white/20 rounded-xl py-3 pl-10 pr-3.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all"
                  />
                </div>
              </div>

              <!-- Correo -->
              <div>
                <label for="hero_lead_email" class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-1">
                  Correo Electrónico
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <Mail class="w-4 h-4" />
                  </div>
                  <input 
                    type="email" 
                    id="hero_lead_email"
                    x-model="email"
                    autocomplete="email"
                    inputmode="email"
                    placeholder="Ej. sofia@correo.com" 
                    class="w-full bg-slate-950/60 border border-white/20 rounded-xl py-3 pl-10 pr-3.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all"
                  />
                </div>
              </div>
            </div>

            <!-- Submit Button (High-conversion mobile touch target) -->
            <div class="pt-1.5 space-y-2">
              <button 
                type="button"
                @click="submitLead()"
                :disabled="!isFormValid || sending"
                class="group w-full bg-gradient-to-r from-gold via-gold-light to-gold hover:from-gold-dark hover:to-gold text-navy font-bold text-sm sm:text-base py-3.5 px-5 rounded-xl shadow-lg shadow-gold/20 hover:shadow-gold/30 transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.99]"
              >
                <div x-show="!sending" class="flex items-center gap-2">
                  <span>Recibir Checklist en mi Correo</span>
                  <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                </div>

                <div x-show="sending" style="display: none;" class="flex items-center gap-2">
                  <svg class="animate-spin h-4 w-4 text-navy" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span class="text-xs uppercase font-semibold">Procesando y enviando...</span>
                </div>
              </button>

              <div class="flex items-center justify-center gap-2 text-[11px] text-slate-400 text-center">
                <Lock class="w-3 h-3 text-slate-400" />
                <span>Privacidad 100% protegida • Sin costo ni spam</span>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Bridge & CTA link to video section -->
      <div class="pt-4 sm:pt-6 flex flex-col items-center justify-center gap-3">
        <div class="flex items-center gap-3 w-full max-w-xs justify-center opacity-70">
          <div class="h-px bg-white/20 flex-1"></div>
          <span class="text-[11px] text-slate-300 uppercase tracking-widest font-medium">O si prefieres</span>
          <div class="h-px bg-white/20 flex-1"></div>
        </div>

        <a 
          href="#video-section" 
          class="inline-flex items-center gap-2.5 bg-gradient-to-r from-gold via-gold-light to-gold hover:from-gold-dark hover:to-gold text-navy font-bold text-sm sm:text-base px-7 py-3.5 rounded-full shadow-xl shadow-black/40 hover:shadow-gold/20 transition-all duration-300 transform hover:scale-105 active:scale-95"
        >
          <Play class="w-4 h-4 fill-navy text-navy" />
          <span>Ver Video y Oferta Especial</span>
        </a>
      </div>
    </div>
  </div>
</section>
