---
import { Gift, User, Mail, ArrowRight, CheckCircle, Lock, Sparkles } from '@lucide/astro';
---

<section id="formulario-rescate" class="relative py-20 md:py-28 bg-gradient-to-b from-[#091124] via-[#0F172A] to-[#020617] text-white overflow-hidden border-t-2 border-gold/30">
  <!-- Glowing Background Orbs -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-gold/10 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute -bottom-24 right-0 w-80 h-80 bg-blue-500/10 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-0 w-72 h-72 bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10 max-w-4xl text-center">
    
    <!-- Top Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 bg-gradient-to-r from-gold/20 via-gold/10 to-gold/20 text-gold-light px-4 py-1.5 rounded-full border border-gold/40 text-xs sm:text-sm font-semibold tracking-wide uppercase mb-6 shadow-inner">
      <Sparkles class="w-4 h-4 text-gold animate-pulse" />
      <span>Recurso Exclusivo de Cortesía</span>
    </div>

    <!-- Main Title -->
    <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold font-serif leading-tight max-w-3xl mx-auto">
      ¿Aún lo estás pensando? <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-light via-gold to-amber-300">
        Da tu primer paso profesional sin costo
      </span>
    </h2>

    <!-- Subtitle -->
    <p class="text-sm sm:text-base md:text-lg text-slate-300 max-w-2xl mx-auto mt-4 mb-10 leading-relaxed font-light">
      Sabemos que dar el paso hacia una nueva profesión es una decisión importante. Por eso, antes de retirarte queremos obsequiarte el <strong class="text-white font-semibold">Checklist Profesional para la Organización de Bodas</strong>, la misma herramienta práctica con la que nuestros egresados coordinan eventos de primer nivel.
    </p>

    <!-- Form Container Card -->
    <div 
      x-data="{
        nombre: '',
        email: '',
        sending: false,
        submitted: false,
        errorMessage: '',
        cleanEmail(val) {
          if (!val) return '';
          return String(val)
            .replace(/^mailto:/i, '')
            .replace(/[\u200B-\u200D\uFEFF\u00A0]/g, '')
            .replace(/\s+/g, '')
            .trim();
        },
        get isEmailValid() {
          const cleaned = this.cleanEmail(this.email);
          return cleaned.length >= 5 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleaned);
        },
        get isFormValid() {
          return this.nombre.trim().length >= 2 && this.isEmailValid;
        },
        async submitLead() {
          if (this.sending) return;
          this.email = this.cleanEmail(this.email);
          this.errorMessage = '';

          if (!this.nombre || this.nombre.trim().length < 2) {
            this.errorMessage = 'Por favor ingresa tu nombre completo (mínimo 2 letras).';
            return;
          }

          if (!this.isEmailValid) {
            this.errorMessage = 'Por favor verifica que tu correo electrónico sea válido.';
            return;
          }

          this.sending = true;

          // Meta Pixel Lead
          try {
            if (window.fbq) {
              fbq('track', 'Lead', {
                content_name: 'Checklist Wedding Planner - Rescate',
                content_category: 'Lead Magnet',
                currency: 'USD',
                value: 0
              });
            }
          } catch(e) {}

          // GA4 Lead
          try {
            if (window.gtag) {
              gtag('event', 'generate_lead', {
                event_category: 'Lead Magnet',
                event_label: 'Checklist Wedding Planner - Rescate'
              });
            }
          } catch(e) {}

          // Payload para Google Sheets
          const payload = JSON.stringify({
            'NOMBRE Y APELLIDOS': this.nombre.trim(),
            'CORREO ELECTRÓNICO': this.email,
            nombre: this.nombre.trim(),
            email: this.email,
            hoja: 'wedding',
            documento: 'LEAD_USA_WEDDING',
            origen: 'weddingusa',
            tipo_lead: 'checklist_wedding_planner',
            seccion: 'rescate_footer',
            page_url: window.location.href,
            user_agent: navigator.userAgent
          });

          try {
            await Promise.race([
              fetch('https://script.google.com/macros/s/AKfycbxhu4jwl2ilgEOa28rqF5dbT6rGPqB4Kzebqphz4D311xYn6CFBFAS63B8sPwVijj40/exec', {
                method: 'POST',
                mode: 'no-cors',
                keepalive: true,
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: payload
              }),
              new Promise((resolve) => setTimeout(resolve, 1400))
            ]);
          } catch(e) {
            console.warn('[Lead Rescate]', e);
          }

          this.sending = false;
          this.submitted = true;
        }
      }"
      class="bg-slate-900/90 backdrop-blur-xl border border-white/15 rounded-3xl p-6 sm:p-9 max-w-xl mx-auto shadow-2xl shadow-black/60 relative overflow-hidden text-left"
    >
      <!-- Decorative Accent Line -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold/30 via-gold to-gold/30"></div>

      <!-- Success State (No redirection, high-level professional message) -->
      <div 
        x-show="submitted" 
        x-transition.opacity 
        style="display: none;" 
        class="text-center py-6 px-2 space-y-4"
      >
        <div class="inline-flex items-center justify-center bg-emerald-500/20 text-emerald-400 p-4 rounded-full border border-emerald-400/30">
          <CheckCircle class="w-12 h-12 text-emerald-400" />
        </div>
        
        <h3 class="text-xl sm:text-2xl font-bold font-serif text-white">¡Checklist enviado con éxito!</h3>
        
        <p class="text-xs sm:text-sm text-slate-300 max-w-md mx-auto leading-relaxed">
          Hemos remitido el <strong class="text-white">Checklist Profesional para Organizar Bodas</strong> directamente a tu correo electrónico. Te sugerimos revisar tu bandeja de entrada (y la carpeta de correo no deseado o promociones para asegurarte de recibirlo de inmediato).
        </p>

        <div class="p-4 bg-white/5 rounded-2xl border border-white/10 text-xs text-slate-400 max-w-md mx-auto">
          <p>
            ¡Te deseamos el mayor de los éxitos en tus proyectos! Si más adelante decides formalizar tus estudios en el Diplomado, los beneficios arancelarios continuarán sujetos a disponibilidad de cupos.
          </p>
        </div>

        <div class="pt-2">
          <a 
            href="#" 
            onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;"
            class="inline-flex items-center gap-2 text-xs sm:text-sm text-gold-light hover:text-white underline underline-offset-4 font-medium transition-colors"
          >
            <span>Volver al inicio de la página</span>
            <span>↑</span>
          </a>
        </div>
      </div>

      <!-- Form Inputs -->
      <div x-show="!submitted" class="space-y-4">
        <div class="text-center mb-5">
          <div class="inline-flex items-center gap-1.5 text-gold text-xs font-semibold uppercase tracking-wider mb-1">
            <Gift class="w-3.5 h-3.5" />
            <span>Descarga Inmediata en PDF</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold font-serif text-white">
            Recibe tu Checklist en tu Correo Electrónico
          </h3>
          <p class="text-xs text-slate-300 mt-1">
            Completa tus datos y te enviaremos el documento al instante.
          </p>
        </div>

        <!-- Nombre -->
        <div>
          <label for="rescate_nombre" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Nombre Completo
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <User class="w-4 h-4" />
            </div>
            <input 
              type="text" 
              id="rescate_nombre"
              x-model="nombre"
              @input="errorMessage = ''"
              autocomplete="name"
              placeholder="Ej. Carolina Mendoza" 
              class="w-full bg-white/10 border border-white/20 rounded-xl py-3 pl-10 pr-4 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all"
            />
          </div>
        </div>

        <!-- Email -->
        <div>
          <label for="rescate_email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Correo Electrónico
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <Mail class="w-4 h-4" />
            </div>
            <input 
              type="text" 
              id="rescate_email"
              x-model="email"
              @input="email = cleanEmail($el.value); errorMessage = ''"
              @paste="$nextTick(() => { email = cleanEmail($el.value); errorMessage = '' })"
              @blur="email = cleanEmail(email)"
              autocomplete="email"
              inputmode="email"
              placeholder="Ej. carolina@correo.com" 
              class="w-full bg-white/10 border border-white/20 rounded-xl py-3 pl-10 pr-4 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all"
            />
          </div>
        </div>

        <!-- Error message if validation fails -->
        <div x-show="errorMessage" x-transition.opacity style="display: none;" class="p-2.5 rounded-lg bg-amber-500/20 border border-amber-400/30 text-amber-200 text-xs flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
          <span x-text="errorMessage"></span>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button 
            type="button"
            @click="submitLead()"
            :disabled="sending"
            class="group w-full bg-gradient-to-r from-gold via-gold-light to-gold hover:from-gold-dark hover:to-gold text-navy font-bold text-sm py-3.5 px-5 rounded-xl shadow-lg shadow-gold/20 hover:shadow-gold/30 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99] disabled:opacity-50"
          >
            <div x-show="!sending" class="flex items-center gap-2">
              <span>Descargar mi Checklist Gratuito</span>
              <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </div>

            <div x-show="sending" style="display: none;" class="flex items-center gap-2">
              <svg class="animate-spin h-4 w-4 text-navy" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="text-xs uppercase font-semibold">Procesando y enviando...</span>
            </div>
          </button>

          <div class="flex items-center justify-center gap-2 text-[11px] text-slate-400 mt-3 text-center">
            <Lock class="w-3 h-3 text-slate-400" />
            <span>Tus datos están protegidos. Sin spam. Material 100% formativo.</span>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
