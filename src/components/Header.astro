---
import { Image } from 'astro:assets';
import logoImage from '../images/logo.webp';

const pathname = new URL(Astro.request.url).pathname;
const isCheckout = pathname.startsWith('/inscripcion') || pathname.startsWith('/registro');
---

<header 
  x-data={`{ atTop: ${isCheckout ? 'false' : 'true'} }`}
  @scroll.window={!isCheckout ? "atTop = (window.pageYOffset > 50) ? false : true" : undefined}
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  :class="atTop ? 'bg-transparent py-4' : 'bg-navy/95 backdrop-blur-md py-3 shadow-lg border-b border-white/10'"
>
  <div class="container mx-auto px-4 flex justify-between items-center max-w-6xl">
    <a href="/" class="flex items-center gap-2 group">
      <img 
        src="/images/logo.webp" 
        alt="Logo Instituto Osbord" 
        class="h-10 md:h-12 w-auto transition-transform duration-300 group-hover:scale-105" 
      />
    </a>

    { !isCheckout && (
    <a href="/inscripcion" onclick="trackInitiateCheckout()" class="font-semibold py-2 px-6 rounded-full transition-all text-sm md:text-base shadow-md hover:shadow-lg uppercase tracking-wider bg-gold text-navy hover:bg-gold-light">
      Inscribirme Ahora
    </a>
    )}
  </div>
</header>
